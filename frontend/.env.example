# Address of the Clear Price API.
#
# Local development: leave this blank. The Vite dev server proxies "/calculate"
# to the FastAPI app running on http://127.0.0.1:8000 (see vite.config.js).
#
# Production (Vercel): set this to the Render backend URL, no trailing slash.
# VITE_API_BASE_URL=https://clear-price-api.onrender.com
VITE_API_BASE_URL=
